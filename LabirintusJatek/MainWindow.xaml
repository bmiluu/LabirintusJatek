<Window x:Class="LabirintusJatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabirintusJatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Focusable="True" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Click="LoadMap_Click" FontSize="24" FontFamily="Bahnschrift">Load Map</Button>
            <Button Grid.Row="2" FontSize="24" FontFamily="Bahnschrift">Display Gilbert</Button>
        </Grid>
        <Viewbox Grid.Column="1" StretchDirection="Both" Stretch="Fill" Margin="0">
            <UniformGrid x:Name="MazeGrid" Background="Black" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased" SnapsToDevicePixels="True"/>
        </Viewbox>
    </Grid>
</Window>
