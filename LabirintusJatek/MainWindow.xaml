<Window x:Class="LabirintusJatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabirintusJatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Focusable="True" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Click="LoadMap_Click" FontSize="24" FontFamily="Bahnschrift" IsDefault="False">Load Map</Button>
            <Button Grid.Row="1" Click="SaveMap_Click" FontSize="24" FontFamily="Bahnschrift" IsDefault="False">Save Map</Button>
            <Button Grid.Row="2" Click="ReloadMap_Click" FontSize="24" FontFamily="Bahnschrift" IsDefault="False">Reload Map</Button>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="14*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            
            
            <Viewbox Grid.Column="0" StretchDirection="Both" Stretch="Fill" Margin="0" Grid.RowSpan="2" Grid.ColumnSpan="3">
                <UniformGrid Focusable="True" x:Name="MazeGrid" Background="Black" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased" SnapsToDevicePixels="True"/>
            </Viewbox>
            
            
            <Label Grid.Row="0" Grid.Column="0" Content="{Binding Player.Position, UpdateSourceTrigger=PropertyChanged}" ContentStringFormat="Player position: {0}" x:Name="PlayerPositionLabel" FontFamily="Bahnschrift" HorizontalAlignment="Stretch" Background="Black" Foreground="White"/>
            <Label Grid.Row="0" Grid.Column="1" Content="{Binding Player.CollectedTreasures, UpdateSourceTrigger=PropertyChanged}" ContentStringFormat="Collected treasures: {0}" x:Name="TreasuresLabel" FontFamily="Bahnschrift" HorizontalAlignment="Stretch" Background="Black" Foreground="White"/>
            <Label Grid.Row="0" Grid.Column="2" Content="{Binding Player.CanExit, UpdateSourceTrigger=PropertyChanged}" ContentStringFormat="Can exit: {0}" x:Name="CanExitLabel" FontFamily="Bahnschrift" HorizontalAlignment="Stretch" Background="Black" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
